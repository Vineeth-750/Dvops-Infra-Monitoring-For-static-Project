global:
  scrape_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    static_configs:
      - targets:
          - "{{ hostvars[groups['web'][0]].ansible_host | default(groups['web'][0]) }}:9100"
          - "localhost:9100"
